            <chunk name="Object" index="382">
              <items count="2">
                <item name="GUID" type_name="gh_guid" type_code="9">1e9e08fc-c31e-49eb-a36c-90de5e62e5f5</item>
                <item name="Name" type_name="gh_string" type_code="10">VB Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="11">
                    <item name="ScriptSource" type_name="gh_string" type_code="10">
    Dim new_pts As New list(Of point3d)
    Dim indx_map As New datatree(Of int32)
    Dim new_path As gh_path = Nothing
    Dim pts1 As List(Of point3d) = Nothing
    Dim pt1, pt2 As point3d
    Dim i,j,k As int32
    Dim dup As Boolean

    For i = 0 To pts.BranchCount - 1
      pts1 = pts.Branch(i)
      new_path = pts.Path(i)

      For j = 0 To pts1.Count - 1
        pt1 = pts1(j)
        dup = False

        For k = 0 To new_pts.count - 1
          pt2 = new_pts(k)

          If SumDev(pt1, pt2) &lt; doc.ModelAbsoluteTolerance Then
            indx_map.add(k, new_path)
            dup = True
            Exit For
          End If

        Next

        If Not dup Then
          new_pts.add(pt1)
          indx_map.add(new_pts.count - 1, new_path)
        End If

      Next

    Next


    A = new_pts
    B = indx_map</item>
                    <item name="AdditionalSource" type_name="gh_string" type_code="10">
  Private Function Sumdev(p1 As point3d, p2 As point3d)As Double
    Return (math.Abs(p1.X - p2.X) + math.Abs(p1.Y - p2.Y) + math.Abs(p1.Z - p2.Z))
  End Function
</item>
                    <item name="ReferenceCount" type_name="gh_int32" type_code="3">0</item>
